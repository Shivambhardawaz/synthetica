# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide native MongoDB URI or leave default (system automatically connects or uses resilient fallback engine)
MONGODB_URI=mongodb://127.0.0.1:27017/email_visit_tracker

# Authentication
JWT_SECRET=super-secret-jwt-key-email-visit-tracker-change-in-production

# Security & SSRF Protection
# Set to 'false' in production environments to strictly block 127.0.0.1 and private network IP ranges
ALLOW_LOCAL_TARGETS=true

# Automation Settings
DEFAULT_SCROLL_DURATION=30
CONCURRENCY_LIMIT=3
